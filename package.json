{
  "name": "twelve-creative-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.33.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "esbuild",
      "ffmpeg-static",
      "unrs-resolver"
    ],
    "overrides": {
      "axios@1.16.1": "1.18.1",
      "@tootallnate/once@2.0.0": "2.0.1",
      "bn.js@4.12.2": "4.12.3",
      "engine.io@6.6.4": "6.6.7",
      "form-data@2.5.5": "2.5.6",
      "form-data@4.0.5": "4.0.6",
      "path-to-regexp@8.2.0": "8.4.0",
      "qs@6.15.0": "6.15.3",
      "socket.io-parser@4.2.4": "4.2.6",
      "uuid@9.0.1": "11.1.1",
      "ws@8.17.1": "8.21.0",
      "ws@8.18.3": "8.21.0"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "npm run start:dev",
    "start": "node ./dist/index.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "seed:admin": "ts-node-dev --transpile-only src/scripts/seeds/admin.seed.ts",
    "seed:admin:prod": "node dist/scripts/seeds/admin.seed.js",
    "seed:initial": "ts-node-dev --transpile-only src/scripts/seeds/initial.seed.ts",
    "seed:initial:prod": "node dist/scripts/seeds/initial.seed.js",
    "seed:industry-media:dev": "ts-node-dev --transpile-only src/scripts/reseed-industry-media.ts",
    "seed:industry-media": "node dist/scripts/reseed-industry-media.js",
    "patch:industry-media": "ts-node-dev --transpile-only src/scripts/add-industry-videos.ts",
    "patch:industry-videos": "ts-node-dev --transpile-only src/scripts/add-industry-videos.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "prettier:fix": "npx prettier --write src",
    "prepare": "husky install",
    "test": "jest",
    "test:watch": "jest --watch --maxWorkers=1",
    "test:coverage": "jest --coverage --maxWorkers=1",
    "compress:videos": "node dist/scripts/compress-existing-videos.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@sendgrid/mail": "^8.1.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/mongo-sanitize": "^1.0.3",
    "amqplib": "^1.2.0",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "flattener-kit": "^1.0.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "isomorphic-dompurify": "^3.20.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "mime-types": "^3.0.2",
    "mongo-sanitize": "^1.1.0",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "redis": "^5.12.1",
    "resend": "^6.18.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/http-status": "^1.1.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.8",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vercel/node": "^5.8.27",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  }
}
